# Copiar a .env y completar con los valores reales de la maquina.
# .env NUNCA se versiona (esta en .gitignore).

# --- Base de datos ---
# Puerto 5433 porque es el que usa el PostgreSQL instalado en esta maquina.
DATABASE_URL=postgresql://facturas_app:CAMBIAR@localhost:5433/facturas
DB_POOL_SIZE=5

# Solo para los tests: usuario con permiso de CREATE DATABASE, para levantar y
# tirar la base aislada donde corren. La app NUNCA lo usa, y por eso el usuario
# de DATABASE_URL no es superusuario ni tiene CREATEDB.
TEST_ADMIN_DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5433/postgres

# --- OCR ---
# Ruta del binario de Tesseract. Sin esto pytesseract lo busca en el PATH y
# falla con un error poco descriptivo.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Carpeta con los modelos de idioma (eng, spa, osd).
TESSDATA_PREFIX=C:\Users\USUARIO\AppData\Local\Tesseract-OCR\tessdata

# Donde EasyOCR guarda los pesos que descarga la primera vez (~100 MB).
EASYOCR_MODEL_DIR=%LOCALAPPDATA%\facturas\easyocr

# Confianza minima (0-100) para que un valor se considere fiable.
# Por debajo, la factura se marca needs_review.
OCR_CONFIDENCE_THRESHOLD=60

# --- Servidor ---
MAX_UPLOAD_MB=10

# Carpeta de imagenes originales y convertidas.
IMAGE_DIR=imagenes